# ==============================================
# Estratégia Fardada Financial Platform - Fase 2
# Copie para .env e preencha com seus valores.
# NUNCA commitar o .env real.
# ==============================================

# ---------- TELEGRAM (OBRIGATÓRIO) ----------
# Token do bot criado no @BotFather.
TELEGRAM_BOT_TOKEN=

# Chat/usuário principal (operador/dono) que recebe alertas.
# Usado também como SUPERADMIN legado. Formato: número inteiro, sem aspas.
TELEGRAM_CHAT_ID=

# Base da URL pública usada no webhook do Telegram.
# Padrão: https://robo-fii-v2.onrender.com
WEBHOOK_URL_BASE=https://robo-fii-v2.onrender.com

# Segredo extra do webhook (header X-Telegram-Bot-Api-Secret-Token).
# Gerar um valor aleatório longo. Nunca commitar o valor real.
# Ausente: o webhook continua autenticado só pelo token no path (legado).
TELEGRAM_WEBHOOK_SECRET=

# ---------- BANCO DE DADOS ----------
# URL de conexão. Se ausente, usa SQLite local de desenvolvimento
# (sqlite:///pipeline_dados/banco_institucional.db).
# Exemplo PostgreSQL/Neon:
# DATABASE_URL=postgres://usuario:senha@host:5432/banco
# Obs: postgres:// é normalizado automaticamente para postgresql://.
DATABASE_URL=

# ---------- ESPELHAMENTO POSTGRESQL (BLOCO 5C) ----------
# false (padrão): comportamento legado, somente Google Sheets (fonte ativa).
# true: o Sheets é gravado primeiro; depois o espelhamento PostgreSQL roda.
# Aceita: true/1/yes/sim/on.
ESPELHAMENTO_PG_ATIVO=false

# ---------- GOOGLE (SHEETS E DRIVE) ----------
# URL da planilha "Banco de Dados" (abas BD_FIIs e BD_Acoes).
SPREADSHEET_URL=

# Credenciais do service account (duas formas: variável JSON ou arquivo).
# Forma 1: conteúdo do JSON da service account.
GOOGLE_CREDS=
# Forma 2: caminho do arquivo de credenciais (padrão: credenciais.json).
GOOGLE_CREDS_FILE=credenciais.json

# Credenciais OAuth do Google Drive (upload de PDFs).
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=
# ID da pasta raiz do Drive onde os documentos são organizados.
DRIVE_ROOT_FOLDER_ID=

# ---------- INTELIGÊNCIA ARTIFICIAL ----------
# Groq (classificação híbrida de documentos).
GROQ_API_KEY=
# Modelo Groq padrão (opcional, padrão: llama-3.3-70b-versatile).
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI / OpenRouter / servidores compatíveis (motor LLM avançado).
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# Ex.: https://openrouter.ai/api/v1 ou http://localhost:11434/v1
OPENAI_BASE_URL=

# ---------- SEGURANÇA (ADMIN) ----------
# IDs (separados por vírgula) com papel ADMIN (comandos administrativos).
ADMIN_CHAT_IDS=
# IDs (separados por vírgula) com papel SUPERADMIN (operações destrutivas).
# Se ausente, ADMIN_CHAT_IDS é considerado SUPERADMIN.
SUPERADMIN_CHAT_IDS=

# ---------- AUTENTICAÇÃO E ADMINISTRAÇÃO (FASE 5) ----------
# TTL de sessões autenticadas em horas (padrão: 168 = 7 dias).
SESSAO_TTL_HORAS=168
# Telegram ID que será elevado a primeiro administrador (seed da Fase 5).
# Vazio por padrão: nenhum usuário é criado/alterado automaticamente.
# Se vazio, o seed usa TELEGRAM_CHAT_ID (dono/operador legado) como referência.
PRIMEIRO_ADMIN_TELEGRAM_ID=
# Trilha de auditoria de acesso (padrão: true).
AUDITORIA_ATIVA=true
# Habilita a API de integração (padrão: false — desabilitada / fail-closed).
# Ausente, vazio ou valor inválido = API desligada. Nunca hardcodar true no código.
# Produção: definir API_ENABLED=true somente no ambiente de deploy, com rate limit.
API_ENABLED=false
# Rate limit in-process (por worker, janela de 60s). 0 desliga o teto.
RATE_LIMIT_API_POR_MINUTO=120
RATE_LIMIT_AUTH_POR_MINUTO=10
# Origens CORS do Website separado (lista, sem wildcard). Vazio = CORS fechado.
# Desenvolvimento: http://localhost:3000 (Next.js em frontend/)
# Produção: somente a origem HTTPS do Website. Nunca "*".
# Com reverse proxy same-origin (/api -> Flask), CORS do browser nao e necessario.
API_CORS_ORIGINS=

# ---------- EXTRAS ----------
# Porta do servidor web (padrão Render: 10000).
PORT=10000
# Token do serviço de logos (motor de imagem).
LOGO_DEV_TOKEN=
